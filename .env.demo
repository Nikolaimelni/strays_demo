# the public demo: `pnpm build:demo`, or `pnpm demo` to build it and open it locally.
# msw answers every api call inside the browser, so none of these point at a real server.
VITE_MOCK_API=true
VITE_API_URL=https://api.invalid
MEDIA_ORIGIN=https://example.r2.cloudflarestorage.com
# nothing is collected, so no inbox; empty also wins over one set in a local .env
VITE_CONTACT_EMAIL=
