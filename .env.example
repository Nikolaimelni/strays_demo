# same registrable domain as the app in production, or the auth cookie is dropped
VITE_API_URL=http://localhost:3000

# the host the API signs photo urls against, which is its S3_ENDPOINT: minio locally,
# https://<account>.r2.cloudflarestorage.com in production. build-time only, it names the
# host in the CSP's img-src. not a pub-*.r2.dev address: that one serves a bucket to the
# whole internet, and this bucket is private.
MEDIA_ORIGIN=http://localhost:9000

# true builds the public demo, with msw answering the API inside the browser. the build
# then wants VITE_API_URL on a host that cannot resolve, like https://api.invalid
VITE_MOCK_API=false

# named on every legal page as the way to reach a person. the demo can leave it out
VITE_CONTACT_EMAIL=you@example.com
